# Copy this file to .env and fill in the values. .env is ignored by git.
#
# Process environment variables take precedence over this file.

# Required for model calls. OPENAI_API_KEY is also accepted.
TRIAGE0_BASELINE_API_KEY=

# Optional: model ID, OpenAI-compatible base URL, and per-token prices.
TRIAGE0_BASELINE_MODEL=gpt-4.1
TRIAGE0_BASELINE_BASE_URL=https://api.openai.com/v1
TRIAGE0_BASELINE_INPUT_USD_PER_1M=
TRIAGE0_BASELINE_OUTPUT_USD_PER_1M=

# Required for the shared LLM client (src/triage0/llm/). There are no defaults.
TRIAGE0_LLM_API_KEY=
TRIAGE0_LLM_MODEL=
TRIAGE0_LLM_BASE_URL=

# Optional: load a different environment file.
# TRIAGE0_ENV_FILE=.env.local
